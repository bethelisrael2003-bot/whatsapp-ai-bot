# Required - Your WhatsApp number for pairing code login (no + sign)
# Example Nigeria: 2348012345678
PHONE_NUMBER=2348012345678

# Required - Get free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Render persistence (free, no credit card)
# Get from https://upstash.com -> Create Redis DB -> REST API section
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Optional
GEMINI_MODEL=gemini-1.5-flash
MAX_HISTORY=20
MAX_PER_HOUR=30
HANDOFF_MINUTES=120
IGNORE_GROUPS=true
REPLY_DELAY_MIN=1000
REPLY_DELAY_MAX=4000

# Optional - Custom personality
SYSTEM_PROMPT=You are a friendly helpful WhatsApp assistant...

# Optional - Owner number for commands (if different)
OWNER_NUMBER=

# Render provides PORT automatically
PORT=10000
